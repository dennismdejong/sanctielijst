# Extra wereldwijde SANCTIE-screening via de OpenSanctions /match-API (OFAC, VN, VK, ...).
# De PEP-data wordt al lokaal doorzocht (data/pep); de key is optioneel.
# Gratis key: https://www.opensanctions.org/account/ (vrij voor niet-commercieel gebruik)
OPENSANCTIONS_API_KEY=
# PEP-zoeken: zet op 0 om uit te schakelen (default: aan als data/pep bestaat)
PEP_INDEX_ENABLED=
# Bouw de zoekindex in een apart subproces (OOM/crash treft alleen de builder, niet de app)
PEP_INDEX_SUBPROCESS=
# Internationale sanctie-lijsten (OFAC, VN, VK, NL-terroristenlijst) via de OpenSanctions 'sanctions'-collectie.
# Zet op 0 om uit te schakelen (default: aan als data/sanctions bestaat)
SANCTIONS_INDEX_ENABLED=
# Pad naar de OpenSanctions sanctions-data (default: data/sanctions)
SANCTIONS_DATA_DIR=
# Pad naar de risicolandenlijst (FATF zwart/grijs + EU high-risk) (default: data/risk_countries.json)
RISK_COUNTRIES=
# Bewaken van namen (watchlists): zet op 1 om in te schakelen (default: uit)
WATCHLIST_ENABLED=0

# Login: eigen gebruikers (data/auth.sqlite) en/of Microsoft Entra ID.
# Verplicht zodra login actief is (AUTH_REQUIRED=1 of AUTH_ENTRA_ENABLED=1).
# Genereer een sterke waarde, bijv.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Pad naar de gebruikersdatabase (default: data/auth.sqlite)
AUTH_DB=
# 1 = zoeken en exporteren vereisen een login (default: 0, open zoeken)
AUTH_REQUIRED=0
# Lokale login met gebruikersnaam/wachtwoord (default: 1)
AUTH_LOCAL_ENABLED=1
# Microsoft Entra ID als Identity Provider
AUTH_ENTRA_ENABLED=0
# Tenant-id of 'organizations'
AUTH_ENTRA_TENANT=
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=
# Redirect-URI, MOET geregistreerd zijn in de Entra-app-registratie
# (bijv. https://sanctielijst.brakketak.nl/api/auth/callback)
AUTH_ENTRA_REDIRECT_URI=
# Scope voor OIDC (default: openid profile email)
AUTH_ENTRA_SCOPE=openid profile email
# Rol voor nieuwe Entra-gebruikers (default: viewer)
AUTH_ENTRA_DEFAULT_ROLE=viewer
