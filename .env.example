# Extra wereldwijde SANCTIE-screening via de OpenSanctions /match-API (OFAC, VN, VK, ...).
# De PEP-data wordt al lokaal doorzocht (data/pep); de key is optioneel.
# Gratis key: https://www.opensanctions.org/account/ (vrij voor niet-commercieel gebruik)
OPENSANCTIONS_API_KEY=
# PEP-zoeken: zet op 0 om uit te schakelen (default: aan als data/pep bestaat)
PEP_INDEX_ENABLED=
